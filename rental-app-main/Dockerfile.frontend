# rental-app-main/Dockerfile.frontend

# --- ЭТАП 1: Сборка ---
FROM node:20-alpine AS build
WORKDIR /app

# Пути теперь относительны папке rental-app-main
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# --- ЭТАП 2: Подача ---
FROM nginx:stable-alpine

COPY --from=build /app/dist /usr/share/nginx/html

# Прод-конфигурация nginx (TLS, проксирование /api) как дефолт.
# Раньше сюда запекался dev-конфиг; dev-конфиги подменяются монтированием
# через docker-compose (override / limited-resources).
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf

# Права для temp-директорий и pid-файла: воркеры nginx работают от
# непривилегированного пользователя nginx (директива `user` в nginx.conf).
# Мастер-процесс остаётся root — официальная модель образа nginx: он читает
# приватные TLS-ключи, смонтированные с хоста (./ssl, ./letsencrypt), и
# занимает порты 80/443. Полный non-root здесь невозможен без переноса
# nginx на непривилегированные порты и запекания сертификатов в образ.
RUN chown -R nginx:nginx /var/cache/nginx \
    && touch /var/run/nginx.pid \
    && chown nginx:nginx /var/run/nginx.pid

EXPOSE 80 443

# 127.0.0.1 (не localhost: в alpine localhost резолвится и в ::1, где nginx не слушает).
# Прод-конфиг на :80 отдаёт 301 на https, поэтому fallback на https
# (busybox wget не следует за редиректом; --no-check-certificate — self-signed/letsencrypt)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 \
        || wget -qO- --no-check-certificate https://127.0.0.1/ >/dev/null 2>&1 \
        || exit 1

CMD ["nginx", "-g", "daemon off;"]
